@page
@model InvWeb.Pages.Masterfiles.InvItemMasters.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Item Masters</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InvItemMaster[0].InvItem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InvItemMaster[0].Remarks)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InvItemMaster[0].LotNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InvItemMaster[0].BatchNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InvItemMaster[0].ItemQty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InvItemMaster[0].InvUom)
            </th>
            <th>
                Brand
            </th>
            <th>
                Origin
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.InvItemMaster) {
            <tr>
                <td>
                    @* @Html.DisplayFor(modelItem => item.InvItem.Description) <br /> *@

                    @{
                        if (@item.InvItem.InvItemSpec_Steel.Count() > 0)
                        {

                            var Spec_steel = @item.InvItem.InvItemSpec_Steel.First();


                            if (Spec_steel != null)
                            {
                                <span>
                                    <!-- Main Category -->
                                    @Spec_steel.SteelMainCat.Name
                                    <!-- Sub Category -->
                                    @Spec_steel.SteelSubCat.Name
                                    <!-- Sizes -->
                                    @Spec_steel.SteelSize.Name
                                    <!-- Brand -->
                                    @Spec_steel.SteelBrand.Name
                                    <!-- Material Grade-->
                                    @Spec_steel.SteelMaterialGrade.Name 
                                    <!--  Steel Material-->
                                    @Spec_steel.SteelMaterial.Name
                                </span>
                            }
                        }
                    }
                 

                   
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Remarks)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LotNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BatchNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ItemQty)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InvUom.uom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InvItemBrand.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InvItemOrigin.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> 
                <!-- <a asp-page="./Delete" asp-route-id="item.Id">Delete</a> -->
            </td>
        </tr>
}
    </tbody>
</table>
