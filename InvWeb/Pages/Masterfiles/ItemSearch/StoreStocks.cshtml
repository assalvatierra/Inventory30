@page

@model InvWeb.Pages.Masterfiles.StoreStock.StoreStocksModel

@{
    ViewData["Title"] = "Store Stocks";
}

<h1>Store Stocks</h1>
<a asp-page="Search">Go back to Search</a>
<h2> Item: @ViewData["Item"] </h2>

<table class="table">
    <thead>
        <tr>
            <th>
                Code
            </th>
            <th>
               Description
            </th>
            <th>
                OnStock
            </th>
            <th>
                Releasing
                Requested
            </th>
            <th>
                Releasing
                Approved
            </th>
            <th>
                Available
            </th>
            <th>
                StoreName
            </th>
            <th>
                Unit
            </th>
            <th> </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.invItemStoreStocks)
        {
            <tr>
                
                <td>
                    @Html.DisplayFor(modelItem => item.InvItem_Code)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InvItem_Description)
                    @* @Html.DisplayFor(modelItem => item.Remarks) *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Qty_Stock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Qty_Released)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Qty_Approved)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Qty_Available)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.store)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InvUom)
                </td>
                <td>
                    <partial name="_PartialStockWarning" model="item" />
                </td>
            </tr>
        }
    </tbody>
</table>
